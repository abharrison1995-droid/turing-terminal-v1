# Keep the master on loopback. Tailscale Serve is the supported remote path.
TT_HOST=127.0.0.1
TT_PORT=4317
# Defaults to ~/.turing-terminal
# TT_DATA_DIR=/path/to/private/data
# TT_LOG_LEVEL=info
# Optional Web Push for notifications while the browser is closed. Generate once with:
# node --input-type=module -e "import webpush from 'web-push'; console.log(JSON.stringify(webpush.generateVAPIDKeys(), null, 2))"
# Keep the private key on the master. Browser vendor push relays are still required for delivery.
# TT_WEB_PUSH_PUBLIC_KEY=
# TT_WEB_PUSH_PRIVATE_KEY=
# TT_WEB_PUSH_SUBJECT=mailto:admin@example.com
