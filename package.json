{
  "name": "turing-terminal",
  "version": "1.0.0-rc1",
  "private": true,
  "type": "module",
  "description": "Local-first orchestration control plane for coding workflows",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch src/server/index.ts\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "tauri": "tauri",
    "desktop:dev": "npm run tauri dev",
    "desktop:build": "npm run tauri build",
    "desktop:build:linux": "node scripts/clean-linux-bundle.mjs && npm run tauri build -- --bundles deb,appimage",
    "desktop:build:windows": "npm run tauri build -- --bundles nsis",
    "desktop:release": "node scripts/collect-release.mjs",
    "package:scan": "node scripts/scan-package.mjs",
    "package:linux": "bash scripts/package-linux.sh",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/windows/package.ps1",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
