{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turing Terminal",
  "version": "1.0.0-rc1",
  "identifier": "com.turingterminal.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Turing Terminal",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Local-first coding workflow control room",
    "longDescription": "A local-first control plane for coding workflows, with a desktop master and mobile PWA.",
    "copyright": "Copyright Turing Terminal",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/"],
    "targets": ["deb", "appimage", "nsis"],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    },
    "windows": {
      "bundleVCRuntime": true,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Turing Terminal",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
