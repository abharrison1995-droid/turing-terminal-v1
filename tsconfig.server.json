{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/server", "src/shared"],
  "exclude": [
    "src/**/*.test.ts",
    "src/server/testUtils.ts",
    "src/server/goals/testKit.ts",
    "src/server/goals/repoKit.ts",
    "src/server/goals/fakeExecutor.ts",
    "src/server/goals/supervisorKit.ts",
    "src/server/goals/testPlanProvider.ts",
    "src/server/goals/turingRunKit.ts"
  ]
}
